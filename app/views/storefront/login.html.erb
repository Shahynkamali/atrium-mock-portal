<div style="max-width: 400px; margin: 60px auto;">
  <div class="card">
    <h2 style="margin-bottom: 20px;">Supplier Portal Login</h2>
    <%= form_tag("/login", method: :post, id: "login-form") do %>
      <div class="form-group">
        <label for="email">Email</label>
        <input type="email" name="email" id="email" placeholder="you@supplier.com" required>
      </div>
      <div class="form-group">
        <label for="password">Password</label>
        <input type="password" name="password" id="password" required>
      </div>
      <button type="submit" class="btn btn-primary" id="login-btn" style="width:100%; margin-top: 8px;">
        Sign In
      </button>
    <% end %>
  </div>
</div>
