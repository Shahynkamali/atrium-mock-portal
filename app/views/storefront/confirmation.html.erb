<div style="max-width: 500px; margin: 40px auto; text-align: center;">
  <div class="card" style="padding: 40px;">
    <div style="font-size: 48px; margin-bottom: 16px;">&#10004;</div>
    <h2 style="color: #16a34a; margin-bottom: 16px;">Order Placed Successfully</h2>
    <p class="text-muted" style="margin-bottom: 8px;">Your confirmation number is:</p>
    <p>
      <span class="badge badge-dark confirmation-number" data-order-number="<%= @order_number %>">
        <%= @order_number %>
      </span>
    </p>
    <p class="text-muted" style="margin-top: 16px;">
      Please save this confirmation number for your records.
      Your order will be processed within 1-2 business days.
    </p>
    <a href="/catalog" class="btn btn-primary" style="margin-top: 16px;">Continue Shopping</a>
  </div>
</div>
